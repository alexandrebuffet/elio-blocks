{
	"name": "@alexandrebuffet/elio-blocks",
	"version": "0.1.0",
	"description": "Displays current weather and weather forecasts from any location with blocks.",
	"author": "Alexandre Buffet",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"files": [
		"elio-blocks.php",
		"functions.php",
		"uninstall.php",
		"readme.txt",
		"LICENSE",
		"build",
		"config",
		"includes",
		"vendor",
		"vendor-prefixed"
	],
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"build": "npm run build:icons && npm run build:weather-condition-icons && wp-scripts build --blocks-manifest --experimental-modules",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"test:js": "wp-scripts test-unit-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip --root-folder=elio-blocks",
		"start": "wp-scripts start --blocks-manifest --experimental-modules",
		"build:weather-condition-icons": "node scripts/build-weather-condition-icons.mjs",
		"build:icons": "svgr src/icons/svg --out-dir src/icons/components && svgr src/blocks/weather-report/icons/svg --out-dir src/blocks/weather-report/icons/components --config-file svgr.weather-report-variation-icons.config.js && svgr src/icons/brand/svg --out-dir src/icons/brand/components --config-file svgr.brand-icons.config.js"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@wordpress/admin-ui": "^2.11.0",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/compose": "^8.9.0",
		"@wordpress/core-data": "^8.1.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/dataviews": "^19.1.0",
		"@wordpress/date": "^5.56.0",
		"@wordpress/dom": "^4.56.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/interactivity": "^6.56.0",
		"@wordpress/primitives": "^4.56.0",
		"@wordpress/theme": "^2.2.0",
		"@wordpress/ui": "^0.23.0",
		"@wordpress/url": "^4.56.0",
		"clsx": "^2.1.1",
		"html-react-parser": "^5.2.17"
	},
	"devDependencies": {
		"@svgr/cli": "^8.1.0",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@wordpress/scripts": "^36.0.0",
		"jsdom": "^26.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"svgo": "^3.3.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
